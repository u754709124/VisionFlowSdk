{
  "flowId": "core-basic",
  "flowName": "Core Basic Demo",
  "schemaVersion": 3,
  "version": "1.0.0",
  "nodes": [
    {
      "id": "set_result",
      "type": "variable.set",
      "name": "设置检测结果",
      "version": "1.0.0",
      "settings": {
        "VariableName": { "Mode": "Constant", "ConstantValue": "Inspection.Result", "Selector": null },
        "Value": { "Mode": "Constant", "ConstantValue": "OK", "Selector": null }
      },
      "executionPolicy": {
        "timeoutMs": 0,
        "maxConcurrentExecutions": 1,
        "retryPolicy": { "enabled": false, "maxRetries": 3, "retryIntervalMs": 1000 },
        "failureStrategy": "StopBranch",
        "defaultOutputs": {}
      }
    },
    {
      "id": "condition_1",
      "type": "condition.if",
      "name": "判断检测结果",
      "version": "3.0.0",
      "settings": {
        "LeftValue": { "Mode": "Variable", "ConstantValue": null, "Selector": { "Scope": "TriggerInput", "Path": ["inspectionResult"] } },
        "Operator": { "Mode": "Constant", "ConstantValue": "Equal", "Selector": null },
        "RightValue": { "Mode": "Constant", "ConstantValue": "OK", "Selector": null }
      },
      "executionPolicy": {
        "timeoutMs": 0,
        "maxConcurrentExecutions": 1,
        "retryPolicy": { "enabled": false, "maxRetries": 3, "retryIntervalMs": 1000 },
        "failureStrategy": "StopBranch",
        "defaultOutputs": {}
      }
    },
    {
      "id": "log_ok",
      "type": "log.write",
      "name": "记录合格结果",
      "version": "1.0.0",
      "settings": {
        "Level": { "Mode": "Constant", "ConstantValue": "Info", "Selector": null },
        "Message": { "Mode": "Constant", "ConstantValue": "Inspection result is OK.", "Selector": null }
      },
      "executionPolicy": {
        "timeoutMs": 0,
        "maxConcurrentExecutions": 1,
        "retryPolicy": { "enabled": false, "maxRetries": 3, "retryIntervalMs": 1000 },
        "failureStrategy": "StopBranch",
        "defaultOutputs": {}
      }
    },
    {
      "id": "log_ng",
      "type": "log.write",
      "name": "记录不合格结果",
      "version": "1.0.0",
      "settings": {
        "Level": { "Mode": "Constant", "ConstantValue": "Warning", "Selector": null },
        "Message": { "Mode": "Constant", "ConstantValue": "Inspection result is not OK.", "Selector": null }
      },
      "executionPolicy": {
        "timeoutMs": 0,
        "maxConcurrentExecutions": 1,
        "retryPolicy": { "enabled": false, "maxRetries": 3, "retryIntervalMs": 1000 },
        "failureStrategy": "StopBranch",
        "defaultOutputs": {}
      }
    }
  ],
  "edges": [
    { "fromNodeId": "set_result", "fromPort": "Next", "toNodeId": "condition_1", "toPort": "In" },
    { "fromNodeId": "condition_1", "fromPort": "True", "toNodeId": "log_ok", "toPort": "In" },
    { "fromNodeId": "condition_1", "fromPort": "False", "toNodeId": "log_ng", "toPort": "In" }
  ],
  "entries": [
    {
      "entryName": "ManualStart",
      "targetNodeId": "set_result",
      "sourceNodeId": null,
      "triggerKind": "Manual",
      "inputs": [
        {
          "name": "inspectionResult",
          "displayName": "检测结果",
          "dataType": "String",
          "isRequired": false,
          "defaultValue": "OK",
          "description": "用于演示强类型字符串条件判断。"
        }
      ],
      "executionPolicy": {
        "maxConcurrentRuns": 1,
        "queueCapacity": 64,
        "queueFullBehavior": "Reject"
      }
    }
  ]
}
